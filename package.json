{
  "name": "noai",
  "version": "0.0.0",
  "private": true,
  "description": "A quiet, local workspace for your coding agents.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "desktop": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "test:browser": "node test/browser/jobs.mjs",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cli": "node bin/noai"
  },
  "engines": {
    "node": ">=22"
  }
}
